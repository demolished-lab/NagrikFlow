# Civic Path Navigator — Environment Variables
# Copy this to .env and fill in the values.

# REQUIRED — Authentication & Security
APP_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
# APP_SECRET_PREV=optional-prev-key-for-rotation  # Set during key rotation only
SESSION_TTL_SECONDS=7200  # 2 hours default

# OPTIONAL — Admin
ADMIN_EMAILS=admin@civic.test  # Comma-separated admin emails
ALLOW_DEV_SECRET=0  # Set to 1 for local dev only (never in production!)

# OPTIONAL — Frontend origins (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# OPTIONAL — Database
# DATABASE_URL=sqlite:///./civic.db  # SQLite (default, local dev)
# DATABASE_URL=postgresql://user:pass@localhost/civic  # Postgres (production)

# OPTIONAL — DigiLocker (API Setu)
DIGILOCKER_ENV=sandbox  # sandbox or production
DIGILOCKER_CLIENT_ID=your-client-id-from-apisetu
DIGILOCKER_CLIENT_SECRET=your-client-secret-from-apisetu
DIGILOCKER_REDIRECT_URI=https://your-domain.com/auth/digilocker/callback

# OPTIONAL — Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret  # Optional: validate X-Telegram-Bot-Api-Secret-Token header

# OPTIONAL — LLM (Bynara / Ollama)
BYNARA_API_KEY=your-by nara-api-key
OLLAMA_MODEL=qwen2.5\:3b  # Local fallback model (use backslash for colon)
OLLAMA_BASE_URL=http://localhost:11434

# OPTIONAL — Email (alerts)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=noreply@civicpath.in
SMTP_PASSWORD=your-smtp-password
